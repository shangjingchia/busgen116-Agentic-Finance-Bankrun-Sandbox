# Copy to .env and fill in values. The .env file is gitignored.

# Required: your OpenRouter API key. We route Claude calls through OpenRouter
# (OpenAI-compatible) rather than the native Anthropic API.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides — model names follow OpenRouter's provider/model convention.
# AGENT_BANKRUN_HAIKU_MODEL=anthropic/claude-haiku-4.5
# AGENT_BANKRUN_SONNET_MODEL=anthropic/claude-sonnet-4.5
# AGENT_BANKRUN_RUNS_DIR=runs

# Optional: shown in OpenRouter rankings (purely cosmetic).
# AGENT_BANKRUN_HTTP_REFERER=https://github.com/yourname/agent-bankrun
# AGENT_BANKRUN_X_TITLE=agent-bankrun
