.env
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.log
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Local Streamlit state — ignore everything EXCEPT the theme config,
# which must be committed so the deployed app matches local appearance.
# (secrets.toml stays ignored — never commit API keys.)
.streamlit/*
!.streamlit/config.toml

# Generated simulation runs (kept out of git; data lives on the runner's disk)
runs/*/
!runs/.gitkeep

# Editor / IDE
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code project files
.claude/

# Scratch / build artifacts from slide tooling
_pptx_extract/
